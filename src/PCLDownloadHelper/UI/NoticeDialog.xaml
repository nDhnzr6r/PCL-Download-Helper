<Window x:Class="PclDownloadHelper.UI.NoticeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提示" Width="440" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Border Background="#FFFFFF" CornerRadius="8" BorderBrush="#C6E2FA" BorderThickness="1" Padding="24,22"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="3" Direction="270" Opacity="0.20" Color="#0A3D66" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" Foreground="#333333" TextWrapping="Wrap" />
            <TextBlock x:Name="BodyText" FontSize="12.5" Foreground="#7C8792" TextWrapping="Wrap" Margin="0,12,0,0"
                       LineHeight="20" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="SecondaryButton" Style="{StaticResource GhostButton}" Height="34" MinWidth="96"
                        Click="Secondary_Click" />
                <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" Height="34" MinWidth="96"
                        Margin="10,0,0,0" Click="Primary_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
